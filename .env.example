# Segredo que assina o cookie de acesso. Troque antes de qualquer deploy.
ACCESS_SECRET=troque-por-um-segredo-longo

# E-mails extras, separados por vírgula. Somam-se a data/allowlist.json.
ALLOWLIST_EMAILS=

# Obrigatório para os webhooks responderem. Sem isso eles devolvem 501.
WEBHOOK_SECRET=

# Cakto: o 'secret' do webhook (painel Cakto > Webhooks). URL: https://SEU-SITE/api/webhooks/cakto
CAKTO_WEBHOOK_SECRET=

